# --- Credenciales Europool ---
EUROPOOL_URL=https://portal.europool.com
EUROPOOL_USER=tu_usuario
EUROPOOL_PASSWORD=tu_password

# --- Credenciales IFCO ---
IFCO_URL=https://portal.ifco.com
IFCO_USER=tu_usuario
IFCO_PASSWORD=tu_password

# --- Credenciales CHEP (opcional) ---
CHEP_URL=https://myaccount.chep.com
CHEP_USER=tu_usuario
CHEP_PASSWORD=tu_password

# --- Rutas ---
# Carpeta donde el ERP deja los ficheros (el watcher vigila la subcarpeta \pendientes)
INPUT_DIR=Z:\scrape-envases

# Carpeta donde aparecen los PDFs completados
OUTPUT_DIR=Z:\scrape-envases\output

SCREENSHOTS_DIR=Z:\scrape-envases\screenshots

# --- Navegador ---
HEADLESS=true
BROWSER_TIMEOUT_MS=30000
RETRY_ATTEMPTS=3

# --- Impresión automática ---
# true = imprime el PDF automáticamente al terminar
AUTO_PRINT=true

# Nombre exacto de la impresora (vacío = impresora predeterminada del sistema)
# Ejemplo: PRINTER_NAME=HP LaserJet Pro M404n
PRINTER_NAME=
